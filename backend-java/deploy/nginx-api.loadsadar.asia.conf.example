# 复制到服务器（如 /etc/nginx/sites-available/）后按需改名，并：
#   sudo ln -s /etc/nginx/sites-available/... /etc/nginx/sites-enabled/
#   sudo certbot --nginx -d api.loadsadar.asia
#   sudo nginx -t && sudo systemctl reload nginx
#
# 约定：Java 监听 127.0.0.1:8080（本机 systemd 或 Docker 发布均可）。

upstream watermark_api {
    server 127.0.0.1:8080;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name api.loadsadar.asia;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name api.loadsadar.asia;

    # certbot 会自动填充 ssl_certificate 等；首次可注释 ssl 块先用 HTTP 调试
    # ssl_certificate /etc/letsencrypt/live/api.loadsadar.asia/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/api.loadsadar.asia/privkey.pem;

    client_max_body_size 200m;

    location / {
        proxy_pass http://watermark_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }
}
