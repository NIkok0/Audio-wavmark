# 复制为 /opt/watermark-api/watermark-api.env（chmod 600），按生产填写。
# systemd 示例见 deploy/systemd/watermark-api.service.example

# ---- 基础 ----
WM_PROFILE=prod
SERVER_PORT=8080

# ---- MySQL（CVM 本机自建）----
WM_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/watermark?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
WM_DATASOURCE_USERNAME=watermark_app
WM_DATASOURCE_PASSWORD=请替换强密码

# ---- Redis（CVM 本机自建）----
WM_REDIS_HOST=127.0.0.1
WM_REDIS_PORT=6379
WM_REDIS_PASSWORD=

# ---- 本机数据目录 ----
WM_INSTANCE_PATH=/opt/watermark-data/instance

# ---- 对象存储：腾讯云 COS ----
WM_STORAGE_BACKEND=cos
WM_COS_SECRET_ID=请替换
WM_COS_SECRET_KEY=请替换
WM_COS_REGION=ap-guangzhou
WM_COS_BUCKET=watermark-xxxxxxxx
# 可选：自定义 STS 策略 JSON，默认仅授予本桶 Put/Get。
# WM_COS_POLICY_JSON=
WM_COS_STS_DURATION=15m

# ---- 若改回 MinIO 自建，把上面 WM_STORAGE_BACKEND 改为 minio 并填写以下项 ----
# WM_MINIO_ENDPOINT=http://127.0.0.1:9000
# WM_MINIO_ACCESS_KEY=
# WM_MINIO_SECRET_KEY=
# WM_MINIO_BUCKET=watermark
# WM_MINIO_REGION=us-east-1

# ---- 浏览器访问（www 与 api 均由 Nginx 反代到本机 Java :8080 时，CORS 多为同源；独立子域 api 时仍按下方 origins）----
WM_CORS_ENABLED=true
WM_CORS_ALLOWED_ORIGINS=https://loadsadar.asia,https://www.loadsadar.asia
# 默认已允许常见方法/头，如需收紧再覆盖：
# WM_CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS,HEAD
# WM_CORS_ALLOWED_HEADERS=*
# WM_CORS_EXPOSED_HEADERS=X-Request-Id
# WM_CORS_MAX_AGE=3600
# 页面与 API 分属不同子域且跨站调 API 时：SameSite=None（application-prod.yml 默认）；www 全站走 Java 同域反代时可改为 lax：
# WM_SESSION_COOKIE_SAME_SITE=lax

# Nginx 终止 TLS 时让 Spring 识别 X-Forwarded-Proto（等价 server.forward-headers-strategy=framework）
SERVER_FORWARD_HEADERS_STRATEGY=framework

# ---- 首次空库自动创建 super_admin（仅用于全新部署）----
# 建完第一个管理员后请把 enabled 改回 false，并轮换密码。
WM_BOOTSTRAP_ADMIN_ENABLED=false
WM_BOOTSTRAP_ADMIN_USERNAME=admin
WM_BOOTSTRAP_ADMIN_EMAIL=admin@loadsadar.asia
WM_BOOTSTRAP_ADMIN_PASSWORD=请替换强密码
