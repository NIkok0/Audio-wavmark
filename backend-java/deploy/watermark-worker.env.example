# 复制为 /opt/watermark-api/watermark-worker.env（chmod 600）。
# 注意：Python Worker 使用 SQLALCHEMY_DATABASE_URI（PyMySQL DSN），与 Java 的 WM_DATASOURCE_URL 等价但键名不同。

# ---- MySQL（同 API 同库，DSN 语法不同）----
SQLALCHEMY_DATABASE_URI=mysql+pymysql://watermark_app:请替换强密码@127.0.0.1:3306/watermark?charset=utf8mb4

# ---- Redis（与 API 对齐）----
WM_REDIS_HOST=127.0.0.1
WM_REDIS_PORT=6379
# WM_REDIS_PASSWORD=

# ---- 任务队列键（与 Java 默认一致，除非你在 API 那边也改过）----
WM_JOBS_STREAM_KEY=wm:stream:watermark
WM_JOBS_CONSUMER_GROUP=wm:workers
WM_JOBS_JOB_KEY_PREFIX=wm:job:
# 消费者名：不填则自动生成 wm-py-xxxxxxxx
# WM_WORKER_CONSUMER_NAME=wm-py-cvm1

# ---- 本机数据目录（与 Java WM_INSTANCE_PATH / Worker INSTANCE_PATH 对齐）----
INSTANCE_PATH=/opt/watermark-data/instance

# ---- 对象存储：腾讯云 COS ----
WM_STORAGE_BACKEND=cos
WM_COS_SECRET_ID=请替换
WM_COS_SECRET_KEY=请替换
WM_COS_REGION=ap-guangzhou
WM_COS_BUCKET=watermark-xxxxxxxx

# ---- 若使用 MinIO 自建，把 WM_STORAGE_BACKEND 改成 minio 并填写：----
# WM_MINIO_ENDPOINT=http://127.0.0.1:9000
# WM_MINIO_ACCESS_KEY=
# WM_MINIO_SECRET_KEY=
# WM_MINIO_BUCKET=watermark
# WM_MINIO_REGION=us-east-1

# ---- 视频算法模型路径（按实际放置目录调整）----
# 见 watermark/utils/watermark_video.py；示例：
# CKPT_PATH=/opt/watermark-data/ckpts/y_256b_img.pth
# FFMPEG_BIN=/usr/bin/ffmpeg
# FFPROBE_BIN=/usr/bin/ffprobe
