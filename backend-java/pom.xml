<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.watermarking</groupId>
    <artifactId>backend-java</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>watermarking Java backend</name>
    <description>Spring Boot API — see backend-java/docs/watermark-java-backend-tech-selection.md</description>

    <modules>
        <module>domain</module>
        <module>infrastructure</module>
        <module>application</module>
        <module>web</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <resilience4j.version>2.2.0</resilience4j.version>
        <cos.version>5.6.227</cos.version>
        <aws.sdk.version>2.25.60</aws.sdk.version>
        <!-- 3.1.962 等旧坐标在 Central 已不可用，与 STS API 兼容的当前线 -->
        <tencent.sts.version>3.1.1239</tencent.sts.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.qcloud</groupId>
                <artifactId>cos_api</artifactId>
                <version>${cos.version}</version>
            </dependency>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws.sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.tencentcloudapi</groupId>
                <artifactId>tencentcloud-sdk-java-sts</artifactId>
                <version>${tencent.sts.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!--
      聚合工程无 main：若不配置，从根目录执行 `mvn -pl web -am spring-boot:run` 时 Maven 仍先对父 POM
      执行 spring-boot:run 并报 Unable to find a suitable main class。子模块 web 显式 skip=false。
    -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
